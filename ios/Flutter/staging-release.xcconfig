#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.staging-release.xcconfig"
#include "Generated.xcconfig"
#include? "Secrets.xcconfig"

BUNDLE_ID=org.pecha.app.staging
APP_NAME=[Staging] WeBuddhist
AUTH0_SCHEME=org.pecha.app.staging
AIRBRIDGE_APP_NAME=webuddhist
